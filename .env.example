# ====================================================================
# CUSTECH MARKETPLACE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Backend (https://supabase.com)
# --------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# --------------------------------------------------------------------
# 2. Paystack Payments (https://dashboard.paystack.com/#/settings/developer)
# --------------------------------------------------------------------
# Obtain your API keys from Paystack Settings -> API Keys & Webhooks.
# Webhook URL to register on Paystack: https://yourdomain.com/api/webhooks/paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# --------------------------------------------------------------------
# 3. Google Gemini AI Engine (https://aistudio.google.com/app/apikey)
# --------------------------------------------------------------------
# Used for campus AI assistant, listing price checks, & description enhancement
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------
# 4. Resend Transactional & Broadcast Email (https://resend.com)
# --------------------------------------------------------------------
# Used for student verification alerts, escrow notifications, and campus updates
RESEND_API_KEY=your_resend_api_key_here
# Set to your verified domain (e.g., CUSTECH Marketplace <noreply@custechmarketplace.com>)
RESEND_FROM_EMAIL=CUSTECH Marketplace <onboarding@resend.dev>

# --------------------------------------------------------------------
# 5. Cron Secret (For automated background tasks & promotional emails)
# --------------------------------------------------------------------
# High-entropy random string to protect /api/cron/* endpoints from public calls
CRON_SECRET=generate_a_secure_random_string_here_32_chars

# --------------------------------------------------------------------
# 6. Marketplace Financial Settings (in Nigerian Kobo: 100 Kobo = 1 NGN)
# --------------------------------------------------------------------
# Student ID verification fee: 100000 Kobo = 1,000 NGN
VERIFICATION_FEE_KOBO=100000
# Referral bonus reward: 50000 Kobo = 500 NGN
REFERRAL_REWARD_KOBO=50000

# --------------------------------------------------------------------
# 7. Production Domain & Administrative Security
# --------------------------------------------------------------------
# Your canonical production URL without trailing slash (e.g., https://custechmarketplace.com)
NEXT_PUBLIC_SITE_URL=https://custechmarketplace.com

# Comma-separated list of bootstrap Super Admin email addresses
ADMIN_EMAILS=your_admin_email@example.com
